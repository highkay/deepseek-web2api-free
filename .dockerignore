# ── Never bake secrets into the image ──────────────────────────
.env
.env.*
data/

# ── VCS / tooling / CI ─────────────────────────────────────────
.git
.github
.codegraph
.pytest_cache/
*.egg-info/

# ── Python bytecode ─────────────────────────────────────────────
__pycache__/
*.pyc

# ── Frontend ─────────────────────────────────────────────────
webui-new/node_modules/
webui-new/.vite/
# dist is produced by the Node stage (Dockerfile); never take a stale local copy
webui-new/dist/

# ── Not needed at runtime ───────────────────────────────────────
tests/
docs/
scripts/
